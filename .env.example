# Enables /dev tools and seeded QR scan simulation in the browser.
# This is a public build-time flag, not an authorization control.
NEXT_PUBLIC_TOKENLY_ENABLE_DEV_TOOLS=false

# Required for the Supabase-backed admin tokener, transaction, claim, private
# account, evidence, and vendor wallet-resolution prototype routes.
# The URL is public configuration. Keep the secret key server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
